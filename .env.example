# ShowTrack configuration
#
# ShowTrack uses The Movie Database (TMDB) as its show database for search,
# posters, episodes and runtimes. Create a free API key at
# https://www.themoviedb.org/settings/api and paste it below.
#
# WITHOUT a key the app still runs in "Demo mode" using a small bundled
# sample library, so you can explore the full interface. Add a key to unlock
# real search and full TV Time imports.

VITE_TMDB_API_KEY=

# Optional: OMDb key (https://www.omdbapi.com/apikey.aspx) adds IMDb ratings
# on show pages. Leave blank to simply hide the IMDb badge.
VITE_OMDB_API_KEY=

# Optional: Supabase (accounts + cloud sync + the key-hiding proxy).
# See SETUP.md. When these are set, the app enables login and routes
# TMDB/OMDb through the secure Edge Function proxy. Both are safe to expose.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
